{
  "key": "group_tefcpt_licensure_page",
  "title": "TEF-CPT Licensure Page",
  "fields": [
    {
      "key": "field_tefcpt_lic_intro_copy",
      "label": "Hero intro copy",
      "name": "hero_intro_copy",
      "type": "wysiwyg",
      "toolbar": "basic",
      "media_upload": 0,
      "instructions": "Body copy under the page H1. Keep to 1–2 sentences."
    },
    {
      "key": "field_tefcpt_lic_eligibility_copy",
      "label": "Eligibility teaser",
      "name": "eligibility_copy",
      "type": "textarea",
      "rows": 4,
      "instructions": "Plain text (supports **bold** and [link](url) markdown). Shown on the eligibility check screen of the guided flow."
    },
    {
      "key": "field_tefcpt_lic_how_it_works",
      "label": "How it works",
      "name": "how_it_works",
      "type": "wysiwyg",
      "toolbar": "full"
    },
    {
      "key": "field_tefcpt_lic_faq_items",
      "label": "FAQ",
      "name": "faq_items",
      "type": "repeater",
      "instructions": "One row per FAQ item. Drag to reorder.",
      "button_label": "Add FAQ item",
      "sub_fields": [
        {
          "key": "field_tefcpt_lic_faq_q",
          "label": "Question",
          "name": "question",
          "type": "text",
          "required": 1
        },
        {
          "key": "field_tefcpt_lic_faq_a",
          "label": "Answer",
          "name": "answer",
          "type": "wysiwyg",
          "toolbar": "basic",
          "media_upload": 0
        }
      ]
    },
    {
      "key": "field_tefcpt_lic_contact",
      "label": "Contact footer",
      "name": "contact_footer",
      "type": "textarea",
      "rows": 3,
      "instructions": "Plain text (supports **bold** and [link](url) markdown). Shown on the eligibility-failed nudge and the all-set screen."
    },
    {
      "key": "field_tefcpt_lic_professions",
      "label": "Professions",
      "name": "professions",
      "type": "repeater",
      "instructions": "One row per profession card. Order is rendered top-to-bottom on the page.",
      "button_label": "Add profession",
      "sub_fields": [
        {
          "key": "field_tefcpt_lic_p_name",
          "label": "Name",
          "name": "name",
          "type": "text",
          "required": 1
        },
        {
          "key": "field_tefcpt_lic_p_slug",
          "label": "Slug",
          "name": "slug",
          "type": "text",
          "required": 1
        },
        {
          "key": "field_tefcpt_lic_p_regulator",
          "label": "Regulator",
          "name": "regulator",
          "type": "select",
          "choices": {"NYSED": "NYSED", "OASAS": "OASAS", "AAMA": "AAMA"},
          "required": 1
        },
        {
          "key": "field_tefcpt_lic_p_form1_pdf",
          "label": "Form 1 PDF",
          "name": "form1_pdf",
          "type": "file",
          "return_format": "url"
        },
        {
          "key": "field_tefcpt_lic_p_form1_revision",
          "label": "Form 1 revision",
          "name": "form1_revision",
          "type": "text"
        },
        {
          "key": "field_tefcpt_lic_p_checklist_urls",
          "label": "Checklist URLs",
          "name": "checklist_urls",
          "type": "repeater",
          "instructions": "One row per NYSED applicant checklist link. Most professions have one; Nursing (RN/PN) has two.",
          "button_label": "Add checklist",
          "sub_fields": [
            {
              "key": "field_tefcpt_lic_p_cl_url",
              "label": "URL",
              "name": "url",
              "type": "url",
              "required": 1
            },
            {
              "key": "field_tefcpt_lic_p_cl_label",
              "label": "Label",
              "name": "label",
              "type": "text",
              "required": 1,
              "instructions": "Short label shown in the link, e.g. \"RN\" or \"PN\" or \"NYSED\"."
            }
          ]
        },
        {
          "key": "field_tefcpt_lic_p_lic_url",
          "label": "Licensure Fee — Asana form URL",
          "name": "licensure_asana_url",
          "type": "url"
        },
        {
          "key": "field_tefcpt_lic_p_lic_walkin",
          "label": "Licensure Fee — walk-in only",
          "name": "licensure_walk_in_only",
          "type": "true_false",
          "ui": 1
        },
        {
          "key": "field_tefcpt_lic_p_lic_notes",
          "label": "Licensure Fee — notes",
          "name": "licensure_notes",
          "type": "text"
        },
        {
          "key": "field_tefcpt_lic_p_exam_url",
          "label": "Exam Fee — Asana form URL",
          "name": "exam_asana_url",
          "type": "url"
        },
        {
          "key": "field_tefcpt_lic_p_exam_walkin",
          "label": "Exam Fee — walk-in only",
          "name": "exam_walk_in_only",
          "type": "true_false",
          "ui": 1
        },
        {
          "key": "field_tefcpt_lic_p_exam_notes",
          "label": "Exam Fee — notes",
          "name": "exam_notes",
          "type": "text"
        },
        {
          "key": "field_tefcpt_lic_p_card_body",
          "label": "Card body copy",
          "name": "card_body",
          "type": "textarea",
          "rows": 3
        },
        {
          "key": "field_tefcpt_lic_p_review_flag",
          "label": "Needs content review",
          "name": "needs_content_review",
          "type": "true_false",
          "ui": 1
        },
        {
          "key": "field_tefcpt_lic_p_review_notes",
          "label": "Content review notes",
          "name": "review_notes",
          "type": "textarea",
          "rows": 2
        }
      ]
    }
  ],
  "location": [
    [
      {"param": "page_template", "operator": "==", "value": "page-licensure.php"}
    ]
  ],
  "menu_order": 0,
  "position": "normal",
  "style": "default",
  "label_placement": "top"
}
