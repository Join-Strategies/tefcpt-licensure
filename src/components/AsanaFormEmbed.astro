---
interface Props {
  asanaFormUrl: string;
  label: string;
  modalId: string;
}
const { asanaFormUrl, label, modalId } = Astro.props;
const embedUrl = asanaFormUrl.includes('embed=') ? asanaFormUrl : `${asanaFormUrl}&embed=true`;
---
<button
  type="button"
  class="asana-trigger"
  data-modal-target={modalId}
  data-asana-src={embedUrl}
>
  {label}
</button>

<dialog id={modalId} class="asana-modal" aria-label={label}>
  <div class="asana-modal-header">
    <h3>{label}</h3>
    <button type="button" class="asana-close" data-modal-close={modalId} aria-label="Close form">×</button>
  </div>
  <div class="asana-modal-body">
    <iframe
      title={label}
      data-asana-iframe={modalId}
      src=""
      width="100%"
      height="100%"
      frameborder="0"
      loading="lazy"
    ></iframe>
  </div>
</dialog>
