---
// THROWAWAY prototype control. Hidden in production via the import.meta.env.DEV gate.
const variants = [
  { key: 'A', label: 'Full-screen Typeform' },
  { key: 'B', label: 'Stepper + content pane' },
  { key: 'C', label: 'Conversational flow' },
];
const isDev = import.meta.env.DEV;
---
{isDev && (
  <div class="proto-switcher" id="proto-switcher" data-variants={JSON.stringify(variants)}>
    <button type="button" class="proto-switcher-arrow" data-proto-prev aria-label="Previous variant">‹</button>
    <span class="proto-switcher-label" data-proto-label>A — Full-screen Typeform</span>
    <button type="button" class="proto-switcher-arrow" data-proto-next aria-label="Next variant">›</button>
  </div>
  <script>
    const el = document.getElementById('proto-switcher');
    const variants = JSON.parse(el.dataset.variants);
    const labelEl = el.querySelector('[data-proto-label]');
    const keys = variants.map((v) => v.key);

    const current = () => new URLSearchParams(location.search).get('variant') || 'A';
    const setLabel = (k) => {
      const v = variants.find((x) => x.key === k) || variants[0];
      labelEl.textContent = `${v.key} — ${v.label}`;
    };
    const go = (delta) => {
      let i = keys.indexOf(current());
      if (i < 0) i = 0;
      const next = keys[(i + delta + keys.length) % keys.length];
      if (typeof window.protoSetVariant === 'function') window.protoSetVariant(next);
      setLabel(next);
    };

    el.querySelector('[data-proto-prev]').addEventListener('click', () => go(-1));
    el.querySelector('[data-proto-next]').addEventListener('click', () => go(1));
    document.addEventListener('keydown', (e) => {
      const a = document.activeElement;
      if (a && (a.tagName === 'INPUT' || a.tagName === 'TEXTAREA' || a.isContentEditable)) return;
      if (e.key === 'ArrowLeft') go(-1);
      else if (e.key === 'ArrowRight') go(1);
    });
    setLabel(current());
  </script>
)}
