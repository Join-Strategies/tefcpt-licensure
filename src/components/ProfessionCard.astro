---
import type { CollectionEntry } from 'astro:content';
import AsanaFormEmbed from './AsanaFormEmbed.astro';

interface Props {
  profession: CollectionEntry<'professions'>;
}
const { profession } = Astro.props;
const data = profession.data;
const slug = profession.slug;
const { Content } = await profession.render();
const base = import.meta.env.BASE_URL;
---
<article class="profession-card" id={`profession-${slug}`} data-regulator={data.regulator}>
  <header class="profession-card-header">
    <h3>{data.name}</h3>
    <span class={`regulator-badge regulator-${data.regulator.toLowerCase()}`}>{data.regulator}</span>
  </header>

  <div class="profession-card-body">
    <Content />

    {data.form1Pdf && (
      <p class="form1-download">
        <a href={`${base}${data.form1Pdf.replace(/^\//, '')}`} download>
          Download Form 1 (PDF)
        </a>
        {data.form1Revision && <small class="form1-revision">{data.form1Revision}</small>}
      </p>
    )}

    {data.checklistUrls && data.checklistUrls.length > 0 ? (
      data.checklistUrls.map(({ url, label }) => (
        <p class="checklist-link">
          <a href={url} target="_blank" rel="noopener noreferrer">
            NYSED applicant checklist ({label}) ↗
          </a>
        </p>
      ))
    ) : data.checklistUrl ? (
      <p class="checklist-link">
        <a href={data.checklistUrl} target="_blank" rel="noopener noreferrer">
          NYSED applicant checklist ↗
        </a>
      </p>
    ) : null}

    {data.licensureFee && (
      <section class="fee-section">
        <h4>Licensure / Application Fee</h4>
        {data.licensureFee.notes && <p class="fee-notes">{data.licensureFee.notes}</p>}
        {data.licensureFee.asanaFormUrl ? (
          <AsanaFormEmbed
            asanaFormUrl={data.licensureFee.asanaFormUrl}
            label="Submit licensure fee request"
            modalId={`modal-${slug}-licensure`}
          />
        ) : data.licensureFee.walkInOnly ? (
          <p class="walk-in-notice">Handled walk-in — contact career services.</p>
        ) : null}
      </section>
    )}

    {data.examFee && (
      <section class="fee-section">
        <h4>Exam Fee</h4>
        {data.examFee.notes && <p class="fee-notes">{data.examFee.notes}</p>}
        {data.examFee.asanaFormUrl ? (
          <AsanaFormEmbed
            asanaFormUrl={data.examFee.asanaFormUrl}
            label="Submit exam fee request"
            modalId={`modal-${slug}-exam`}
          />
        ) : data.examFee.walkInOnly ? (
          <p class="walk-in-notice">Handled walk-in — contact career services.</p>
        ) : null}
      </section>
    )}

    {data.needsContentReview && (
      <p class="content-review-flag" hidden data-review-notes={data.reviewNotes ?? ''}>
        Content review pending.
      </p>
    )}
  </div>
</article>
