---
import { getCollection, getEntry } from 'astro:content';
import Page from '../layouts/Page.astro';
import Hero from '../components/Hero.astro';
import FAQ from '../components/FAQ.astro';
import ContactFooter from '../components/ContactFooter.astro';

const base = import.meta.env.BASE_URL;

function feeKind(f) {
  if (!f) return { kind: 'none', notes: null };
  if (f.asanaFormUrl) return { kind: 'asana', url: f.asanaFormUrl, notes: f.notes ?? null };
  if (f.walkInOnly) return { kind: 'walkin', notes: f.notes ?? null };
  return { kind: 'none', notes: f.notes ?? null };
}

const professions = (await getCollection('professions')).sort(
  (a, b) => a.data.order - b.data.order
);

const profData = professions.map((p) => {
  const d = p.data;
  const checklists =
    d.checklistUrls && d.checklistUrls.length
      ? d.checklistUrls
      : d.checklistUrl
        ? [{ url: d.checklistUrl, label: 'NYSED' }]
        : [];
  return {
    slug: p.slug,
    name: d.name,
    regulator: d.regulator,
    intro: p.body.trim(),
    form1Pdf: d.form1Pdf ? `${base}${d.form1Pdf.replace(/^\//, '')}` : null,
    form1Revision: d.form1Revision,
    checklists,
    licensure: feeKind(d.licensureFee),
    exam: feeKind(d.examFee),
  };
});

const processEntries = await getCollection('processes');
const processes = Object.fromEntries(
  processEntries.map((entry) => [
    entry.data.regulator,
    {
      prepHeading: entry.data.prepHeading ?? 'Prepare',
      submitHeading: entry.data.submitHeading,
      submitIntro: entry.data.submitIntro ?? null,
      prepSteps: entry.data.prepSteps,
    },
  ])
);

const eligibility = await getEntry('page', 'eligibility');
const contact = await getEntry('page', 'contact');
const config = {
  eligibilityText: eligibility?.body.trim() ?? '',
  contactText: contact?.body.trim() ?? '',
};
---
<Page
  title="Licensure & Exam Fees"
  description="TEF-CPT participants: a guided walkthrough for licensure and exam fee coverage by profession."
>
  <Hero />

  <div id="flow-root" class="lf-root"></div>
  <script type="application/json" id="flow-data" set:html={JSON.stringify(profData)} />
  <script type="application/json" id="flow-processes" set:html={JSON.stringify(processes)} />
  <script type="application/json" id="flow-config" set:html={JSON.stringify(config)} />

  <FAQ />
  <ContactFooter />

  <script src={`${base}licensure-flow.js`} defer></script>
</Page>
