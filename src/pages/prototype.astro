---
// THROWAWAY PROTOTYPE — guided / Typeform-style redesign of the licensure page.
// Three structurally-different guided UIs over one shared flow, switchable via ?variant=.
// See src/components/prototype/NOTES.md for the question this is answering.
// Do NOT promote this file as-is; fold the winning variant into the real page and delete the rest.
import { getCollection, getEntry } from 'astro:content';
import Page from '../layouts/Page.astro';
import PrototypeSwitcher from '../components/prototype/PrototypeSwitcher.astro';

const base = import.meta.env.BASE_URL;

function feeKind(f) {
  if (!f) return { kind: 'none', notes: null };
  if (f.asanaFormUrl) return { kind: 'asana', notes: f.notes ?? null };
  if (f.walkInOnly) return { kind: 'walkin', notes: f.notes ?? null };
  return { kind: 'none', notes: f.notes ?? null };
}

const professions = (await getCollection('professions')).sort(
  (a, b) => a.data.order - b.data.order
);

const profData = professions.map((p) => {
  const d = p.data;
  const checklists =
    d.checklistUrls && d.checklistUrls.length
      ? d.checklistUrls
      : d.checklistUrl
        ? [{ url: d.checklistUrl, label: 'NYSED' }]
        : [];
  return {
    slug: p.slug,
    name: d.name,
    regulator: d.regulator,
    intro: p.body.trim(),
    form1Pdf: d.form1Pdf ? `${base}${d.form1Pdf.replace(/^\//, '')}` : null,
    form1Revision: d.form1Revision,
    checklists,
    licensure: feeKind(d.licensureFee),
    exam: feeKind(d.examFee),
  };
});

const eligibility = await getEntry('page', 'eligibility');
const contact = await getEntry('page', 'contact');

const config = {
  eligibilityText: eligibility?.body.trim() ?? '',
  contactText: contact?.body.trim() ?? '',
};
---
<Page
  title="Licensure & Exam Fees — Guided Prototype"
  description="Throwaway prototype: guided licensure & exam fee flow."
>
  <script type="application/json" id="proto-data" set:html={JSON.stringify(profData)} />
  <script type="application/json" id="proto-config" set:html={JSON.stringify(config)} />

  <div id="variant-A" class="proto-variant" hidden></div>
  <div id="variant-B" class="proto-variant" hidden></div>
  <div id="variant-C" class="proto-variant" hidden></div>

  <PrototypeSwitcher />
</Page>

<style is:global>
  /* THROWAWAY prototype styles. Not in the shared public/styles.css. */
  body { background: var(--color-soft-bg); }
  .page { max-width: 1100px; }
  .proto-variant[hidden] { display: none; }

  .proto-btn {
    appearance: none;
    border: none;
    border-radius: 8px;
    background: var(--color-accent);
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.7rem 1.2rem;
    cursor: pointer;
  }
  .proto-btn:hover { background: var(--color-accent-hover); }
  .proto-btn.ghost {
    background: transparent;
    color: var(--color-accent);
    border: 1px solid var(--color-border);
  }
  .proto-btn.ghost:hover { background: #eef3f8; color: var(--color-accent-hover); }

  .proto-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 2px 8px;
    border-radius: 999px;
    color: #fff;
    text-transform: uppercase;
  }
  .proto-badge[data-reg="NYSED"] { background: var(--color-nysed); }
  .proto-badge[data-reg="OASAS"] { background: var(--color-oasas); }
  .proto-badge[data-reg="AAMA"] { background: var(--color-aama); }

  .proto-stub {
    border: 1px dashed var(--color-border);
    border-radius: 8px;
    background: #fff;
    padding: var(--space-2);
    color: var(--color-muted);
    font-size: 0.9rem;
    margin: var(--space-2) 0;
  }
  .proto-stub .proto-stub-tag {
    display: inline-block;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: #fde68a;
    color: #7a5b00;
    border-radius: 4px;
    padding: 1px 6px;
    margin-bottom: 6px;
  }

  /* ---------- Variant A: full-screen Typeform ---------- */
  .tf {
    position: fixed;
    inset: 0;
    background: #fff;
    display: flex;
    flex-direction: column;
  }
  .tf-progress { height: 4px; background: #e6ebf1; }
  .tf-progress-bar { height: 100%; background: var(--color-accent); transition: width 0.25s ease; }
  .tf-stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 720px;
    width: 100%;
    margin: 0 auto;
    padding: var(--space-4) var(--space-3);
  }
  .tf-kicker { color: var(--color-muted); font-size: 0.85rem; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: var(--space-1); }
  .tf-stage h2 { font-size: 1.8rem; line-height: 1.2; margin-bottom: var(--space-2); }
  .tf-stage .tf-body { color: var(--color-muted); font-size: 1.05rem; margin-bottom: var(--space-3); }
  .tf-choices { display: flex; flex-direction: column; gap: var(--space-1); }
  .tf-choice {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-align: left;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 0.9rem 1rem;
    font-size: 1.05rem;
    cursor: pointer;
  }
  .tf-choice:hover, .tf-choice:focus-visible { border-color: var(--color-accent); background: #f3f8fd; outline: none; }
  .tf-choice .tf-key {
    flex: none;
    width: 26px; height: 26px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    display: grid; place-items: center;
    font-size: 0.8rem; font-weight: 600; color: var(--color-muted);
  }
  .tf-nav { display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); margin-top: var(--space-4); }
  .tf-hint { color: var(--color-muted); font-size: 0.8rem; }

  /* ---------- Variant B: stepper + content pane ---------- */
  .stp { display: grid; grid-template-columns: 280px 1fr; gap: var(--space-4); margin-top: var(--space-3); align-items: start; }
  .stp-rail { position: sticky; top: var(--space-3); }
  .stp-rail h2 { font-size: 1.1rem; }
  .stp-steps { list-style: none; margin: 0; padding: 0; }
  .stp-step {
    display: flex; gap: var(--space-2); align-items: flex-start;
    padding: 0.6rem 0; cursor: pointer; color: var(--color-muted);
    border-left: 2px solid transparent; padding-left: var(--space-2);
  }
  .stp-step .stp-dot {
    flex: none; width: 22px; height: 22px; border-radius: 999px;
    border: 2px solid var(--color-border); display: grid; place-items: center;
    font-size: 0.75rem; font-weight: 700; background: #fff;
  }
  .stp-step.is-active { color: var(--color-text); font-weight: 600; border-left-color: var(--color-accent); }
  .stp-step.is-active .stp-dot { border-color: var(--color-accent); color: var(--color-accent); }
  .stp-step.is-done { color: var(--color-text); cursor: pointer; }
  .stp-step.is-done .stp-dot { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }
  .stp-step.is-locked { opacity: 0.5; cursor: default; }
  .stp-pane {
    background: #fff; border: 1px solid var(--color-border);
    border-radius: var(--radius); padding: var(--space-4); min-height: 360px;
  }
  .stp-pane h2 { font-size: 1.5rem; }
  .stp-pane-body { color: var(--color-text); font-size: 1rem; }
  .stp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px,1fr)); gap: var(--space-2); }
  .stp-pane-nav { display: flex; justify-content: space-between; margin-top: var(--space-4); }

  /* ---------- Variant C: conversational ---------- */
  .chat { max-width: 680px; margin: var(--space-3) auto 0; }
  .chat-log { display: flex; flex-direction: column; gap: var(--space-2); padding-bottom: var(--space-3); }
  .chat-msg { max-width: 80%; padding: 0.7rem 1rem; border-radius: 14px; font-size: 1rem; line-height: 1.45; }
  .chat-msg.bot { align-self: flex-start; background: #fff; border: 1px solid var(--color-border); border-bottom-left-radius: 4px; }
  .chat-msg.user { align-self: flex-end; background: var(--color-accent); color: #fff; border-bottom-right-radius: 4px; }
  .chat-msg.user a { color: #fff; }
  .chat-chips {
    position: sticky; bottom: 0; display: flex; flex-wrap: wrap; gap: var(--space-1);
    padding: var(--space-2) 0; background: linear-gradient(to top, var(--color-soft-bg) 70%, transparent);
  }
  .chat-chip {
    appearance: none; border: 1px solid var(--color-accent); background: #fff; color: var(--color-accent);
    border-radius: 999px; padding: 0.5rem 1rem; font-size: 0.95rem; font-weight: 600; cursor: pointer;
  }
  .chat-chip:hover { background: var(--color-accent); color: #fff; }
  .chat-typing { align-self: flex-start; color: var(--color-muted); font-size: 0.85rem; font-style: italic; }

  /* ---------- Switcher ---------- */
  .proto-switcher {
    position: fixed; z-index: 50; left: 50%; bottom: 18px; transform: translateX(-50%);
    display: flex; align-items: center; gap: 6px;
    background: #111; color: #fff; border-radius: 999px;
    padding: 6px 8px; box-shadow: 0 6px 24px rgba(0,0,0,0.28);
    font-size: 0.85rem;
  }
  .proto-switcher-label { padding: 0 10px; white-space: nowrap; }
  .proto-switcher-arrow {
    appearance: none; border: none; background: #2a2a2a; color: #fff;
    width: 30px; height: 30px; border-radius: 999px; font-size: 1.1rem; cursor: pointer; line-height: 1;
  }
  .proto-switcher-arrow:hover { background: #3d3d3d; }

  @media (max-width: 760px) {
    .stp { grid-template-columns: 1fr; }
    .stp-rail { position: static; }
  }
</style>

<script>
  // ===== Shared model =====================================================
  const PROFS = JSON.parse(document.getElementById('proto-data').textContent);
  const CONFIG = JSON.parse(document.getElementById('proto-config').textContent);

  function esc(s) {
    return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
  function md(s) {
    return esc(s)
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
      .replace(/\n{2,}/g, '<br><br>');
  }
  const profBySlug = (slug) => PROFS.find((p) => p.slug === slug);

  const stub = (label) =>
    `<div class="proto-stub"><span class="proto-stub-tag">Prototype stub</span>` +
    `<div>${esc(label)} — the live form/PDF is wired up in the real page; here it's a placeholder.</div></div>`;

  // The "how it works" walkthrough + the prerequisite gate that unlocks the fee forms.
  // The gate is the notarization checkpoint: people only reach the form once they confirm
  // they're ready, so they can't start a form and lose their place.
  function processFlow(p) {
    if (p.regulator === 'NYSED') {
      const rev = p.form1Revision ? ` <em>(${esc(p.form1Revision)})</em>` : '';
      return {
        steps: [
          {
            title: 'Download & complete Form 1',
            bodyHtml: `Download Form 1 for <strong>${esc(p.name)}</strong> and fill it out completely.${rev}` + (p.form1Pdf ? stub('Download Form 1 (PDF)') : ''),
          },
          {
            title: 'Get Form 1 notarized',
            bodyHtml: 'New York State requires your Form 1 to be <strong>notarized</strong>. Do this <strong>before</strong> you start the fee request — the form is quick and you don\'t want to lose your place partway through.',
          },
          {
            title: 'Submit to TEF with your fee request',
            bodyHtml: 'Once it\'s notarized, you submit Form 1 through the fee request. TEF mails it to New York State along with your payment.',
          },
        ],
        gateTitle: 'Is your Form 1 notarized?',
        gateBody: 'You\'ll need a completed, notarized Form 1 in hand to finish the fee request in one sitting.',
        gateYes: 'Yes — my Form 1 is notarized',
        gateNo: 'Not yet — I still need to notarize',
        gateNoBody: 'No problem. Get your completed Form 1 notarized, then come back and pick up right here.',
      };
    }
    if (p.regulator === 'OASAS') {
      return {
        steps: [
          { title: 'Submit your CASAC intake form', bodyHtml: 'CASAC is regulated by <strong>OASAS</strong>, not NYSED. Start with TEF\'s combined intake form — it covers both licensure and exam fees.' },
          { title: 'TEF emails you a confirmation letter', bodyHtml: 'After you submit, TEF emails you an OASAS letter confirming payment.' },
          { title: 'Upload the letter to OASAS', bodyHtml: 'Attach that confirmation letter when you submit your licensure and exam fee application to OASAS.' },
        ],
        gateTitle: 'Ready to start your intake?',
        gateBody: 'No notarization needed for CASAC — the combined intake form is your first step.',
        gateYes: 'Start my intake form',
        gateNo: null,
      };
    }
    return {
      steps: [
        { title: 'TEF can cover your exam fee', bodyHtml: `<strong>${esc(p.name)}</strong> is certified nationally through AAMA (not New York State). TEF can pay your exam fee for eligible participants — no Form 1 or notarization required.` },
      ],
      gateTitle: 'Ready to request your exam fee?',
      gateBody: 'Just one step for you.',
      gateYes: 'Start my exam fee request',
      gateNo: null,
    };
  }

  // The actionable fee tasks — the non-linear part. Pick what you need; do one, both, or neither.
  function feeTasks(p) {
    const tasks = [];
    if (p.licensure.kind === 'asana')
      tasks.push({ key: 'lic', label: 'Licensure / application fee', bodyHtml: (p.licensure.notes ? md(p.licensure.notes) : 'Submit your licensure fee request to TEF.') + stub('Open licensure fee request form') });
    else if (p.licensure.kind === 'walkin')
      tasks.push({ key: 'lic', label: 'Licensure fee — walk-in', bodyHtml: md(p.licensure.notes || 'Handled walk-in. Contact career services for next steps.') });
    if (p.exam.kind === 'asana')
      tasks.push({ key: 'exam', label: 'Exam fee', bodyHtml: (p.exam.notes ? md(p.exam.notes) : 'Submit your exam fee request to TEF.') + stub('Open exam fee request form') });
    else if (p.exam.kind === 'walkin')
      tasks.push({ key: 'exam', label: 'Exam fee — walk-in', bodyHtml: md(p.exam.notes || 'Handled walk-in. Contact career services for next steps.') });
    return tasks;
  }

  function checklistHtml(p) {
    if (!p.checklists.length) return '';
    return '<p style="margin-top:var(--space-2)">' + p.checklists.map((c) => `<a href="${c.url}" target="_blank" rel="noopener">Official NYSED checklist (${esc(c.label)}) &#8599;</a>`).join('<br>') + '</p>';
  }

  // ===== Variant A — full-screen Typeform =================================
  // Walks the "how it works" steps, hits a notarization gate, then a non-linear fee hub.
  function mountA(root) {
    const state = { phase: 'eligibility', slug: null, idx: 0, task: null, done: {} };
    const flow = () => processFlow(profBySlug(state.slug));
    const tasks = () => feeTasks(profBySlug(state.slug));

    function progress() {
      if (state.phase === 'eligibility' || state.phase === 'ineligible') return 0.05;
      if (state.phase === 'profession') return 0.15;
      if (state.phase === 'process') return 0.2 + 0.4 * ((state.idx + 1) / (flow().steps.length + 1));
      if (state.phase === 'gate' || state.phase === 'gateNo') return 0.65;
      if (state.phase === 'detail') return 0.85;
      return 1;
    }

    function render() {
      const pct = Math.round(progress() * 100);
      const p = state.slug ? profBySlug(state.slug) : null;
      let stage = '';

      if (state.phase === 'eligibility') {
        stage = `
          <p class="tf-kicker">Before we start</p>
          <h2>Are you an active 1199SEIU TEF CPT participant?</h2>
          <p class="tf-body">${md(CONFIG.eligibilityText)}</p>
          <div class="tf-choices" data-choices>
            <button class="tf-choice" data-act="yes"><span class="tf-key">1</span> Yes, I'm an active participant</button>
            <button class="tf-choice" data-act="no"><span class="tf-key">2</span> No / I'm not sure</button>
          </div>`;
      } else if (state.phase === 'ineligible') {
        stage = `
          <p class="tf-kicker">Hold on</p>
          <h2>Let's confirm your eligibility first</h2>
          <p class="tf-body">${md(CONFIG.contactText)}</p>
          <div class="tf-nav"><button class="proto-btn ghost" data-act="back">← Back</button></div>`;
      } else if (state.phase === 'profession') {
        const choices = PROFS.map(
          (pr, i) =>
            `<button class="tf-choice" data-act="pick" data-slug="${pr.slug}">
              <span class="tf-key">${i + 1}</span>
              <span>${esc(pr.name)}</span>
              <span class="proto-badge" data-reg="${pr.regulator}" style="margin-left:auto">${pr.regulator}</span>
            </button>`
        ).join('');
        stage = `
          <p class="tf-kicker">Step 1</p>
          <h2>What are you pursuing?</h2>
          <p class="tf-body">Pick your profession and we'll walk you through how it works.</p>
          <div class="tf-choices" data-choices>${choices}</div>`;
      } else if (state.phase === 'process') {
        const f = flow();
        const s = f.steps[state.idx];
        const last = state.idx === f.steps.length - 1;
        stage = `
          <p class="tf-kicker">How it works · ${state.idx + 1} of ${f.steps.length} <span class="proto-badge" data-reg="${p.regulator}">${p.regulator}</span></p>
          <h2>${esc(s.title)}</h2>
          <div class="tf-body">${s.bodyHtml}</div>
          <div class="tf-nav">
            <button class="proto-btn ghost" data-act="prev">← Back</button>
            <span class="tf-hint">Press <strong>Enter</strong> to continue</span>
            <button class="proto-btn" data-act="${last ? 'togate' : 'next'}">${last ? 'Next: get started →' : 'Continue →'}</button>
          </div>`;
      } else if (state.phase === 'gate') {
        const f = flow();
        const choices = (f.gateNo
          ? [[f.gateYes, 'gate-yes'], [f.gateNo, 'gate-no']]
          : [[f.gateYes, 'gate-yes']]
        ).map(([label, act], i) => `<button class="tf-choice" data-act="${act}"><span class="tf-key">${i + 1}</span>${esc(label)}</button>`).join('');
        stage = `
          <p class="tf-kicker">Before the form</p>
          <h2>${esc(f.gateTitle)}</h2>
          <p class="tf-body">${esc(f.gateBody)}</p>
          <div class="tf-choices" data-choices>${choices}</div>`;
      } else if (state.phase === 'gateNo') {
        const f = flow();
        stage = `
          <p class="tf-kicker">Almost there</p>
          <h2>Get Form 1 notarized first</h2>
          <p class="tf-body">${esc(f.gateNoBody)}</p>
          <div class="tf-nav"><button class="proto-btn ghost" data-act="back-process">← Back to the steps</button></div>`;
      } else if (state.phase === 'detail') {
        if (state.task) {
          const t = tasks().find((x) => x.key === state.task);
          stage = `
            <p class="tf-kicker">${esc(p.name)}</p>
            <h2>${esc(t.label)}</h2>
            <div class="tf-body">${t.bodyHtml}</div>
            <div class="tf-nav">
              <button class="proto-btn ghost" data-act="hub">← Other options</button>
              <button class="proto-btn" data-act="mark-done">${state.done[t.key] ? 'Done ✓' : 'Mark done →'}</button>
            </div>`;
        } else {
          const ts = tasks();
          const choices = ts.map((t, i) =>
            `<button class="tf-choice" data-act="task" data-task="${t.key}"><span class="tf-key">${i + 1}</span><span>${esc(t.label)}</span>${state.done[t.key] ? '<span style="margin-left:auto;color:var(--color-accent)">✓ done</span>' : ''}</button>`
          ).join('');
          stage = `
            <p class="tf-kicker">${esc(p.name)}</p>
            <h2>What do you need to pay for?</h2>
            <p class="tf-body">Pick one — you can come back for the other.${checklistHtml(p)}</p>
            <div class="tf-choices" data-choices>${choices}
              <button class="tf-choice" data-act="finish"><span class="tf-key">${ts.length + 1}</span>I'm all set</button>
            </div>`;
        }
      } else {
        stage = `
          <p class="tf-kicker">Done</p>
          <h2>You're all set</h2>
          <div class="tf-body">${md(CONFIG.contactText)}</div>
          <div class="tf-nav"><button class="proto-btn" data-act="restart">Start over</button></div>`;
      }

      root.innerHTML = `
        <div class="tf">
          <div class="tf-progress"><div class="tf-progress-bar" style="width:${pct}%"></div></div>
          <div class="tf-stage">${stage}</div>
        </div>`;
    }

    root.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-act]');
      if (!btn) return;
      switch (btn.dataset.act) {
        case 'yes': state.phase = 'profession'; break;
        case 'no': state.phase = 'ineligible'; break;
        case 'back': state.phase = 'eligibility'; break;
        case 'pick': state.slug = btn.dataset.slug; state.phase = 'process'; state.idx = 0; state.done = {}; break;
        case 'next': state.idx = Math.min(state.idx + 1, flow().steps.length - 1); break;
        case 'prev': if (state.idx === 0) { state.phase = 'profession'; state.slug = null; } else state.idx -= 1; break;
        case 'togate': state.phase = 'gate'; break;
        case 'gate-yes': state.phase = 'detail'; state.task = null; break;
        case 'gate-no': state.phase = 'gateNo'; break;
        case 'back-process': state.phase = 'process'; state.idx = flow().steps.length - 1; break;
        case 'task': state.task = btn.dataset.task; break;
        case 'mark-done': state.done[state.task] = true; state.task = null; break;
        case 'hub': state.task = null; break;
        case 'finish': state.phase = 'finish'; break;
        case 'restart': state.phase = 'eligibility'; state.slug = null; state.idx = 0; state.task = null; state.done = {}; break;
      }
      render();
    });

    const keyHandler = (e) => {
      if (root.hidden) return;
      const a = document.activeElement;
      if (a && (a.tagName === 'INPUT' || a.tagName === 'TEXTAREA')) return;
      if (e.key === 'Enter' && state.phase === 'process') {
        if (state.idx === flow().steps.length - 1) state.phase = 'gate';
        else state.idx += 1;
        render();
        return;
      }
      if (/^[1-9]$/.test(e.key)) {
        const choices = root.querySelectorAll('[data-choices] .tf-choice');
        const target = choices[parseInt(e.key, 10) - 1];
        if (target) target.click();
      }
    };
    document.addEventListener('keydown', keyHandler);
    root._cleanup = () => document.removeEventListener('keydown', keyHandler);

    render();
  }

  // ===== Variant B — stepper + content pane ===============================
  // Rail = eligibility, profession, process steps, the gate, then the fee tasks.
  // Once the gate is passed the fee tasks unlock and are freely jumpable (non-linear).
  function mountB(root) {
    const state = { eligible: null, slug: null, passedGate: false, gateNo: false, active: 0, done: {} };

    function items() {
      const list = [{ key: 'elig', label: 'Eligibility' }, { key: 'prof', label: 'Profession' }];
      if (state.eligible && state.slug) {
        const f = processFlow(profBySlug(state.slug));
        f.steps.forEach((s, i) => list.push({ key: 'proc' + i, label: s.title, proc: i }));
        list.push({ key: 'gate', label: 'Get started' });
        if (state.passedGate) {
          feeTasks(profBySlug(state.slug)).forEach((t) => list.push({ key: 'task:' + t.key, label: t.label, task: t.key }));
          list.push({ key: 'done', label: 'All set' });
        }
      }
      return list;
    }

    const keyIndex = (key) => items().findIndex((x) => x.key === key);
    function clickable(it) {
      if (it.key === 'elig') return true;
      if (it.key === 'prof') return !!state.eligible;
      if (it.key === 'gate' || it.proc != null) return !!state.slug;
      return state.passedGate;
    }
    function isDone(it) {
      if (it.key === 'elig') return !!state.eligible;
      if (it.key === 'prof') return !!state.slug;
      if (it.proc != null || it.key === 'gate') return state.passedGate;
      if (it.task) return !!state.done[it.task];
      return false;
    }

    function pane(it) {
      const p = state.slug ? profBySlug(state.slug) : null;
      if (it.key === 'elig') {
        return `<h2>Are you an active TEF CPT participant?</h2><div class="stp-pane-body"><p>${md(CONFIG.eligibilityText)}</p></div><div class="stp-grid" style="margin-top:var(--space-3)"><button class="proto-btn" data-b="elig-yes">Yes, I'm active</button><button class="proto-btn ghost" data-b="elig-no">No / not sure</button></div>`;
      }
      if (it.key === 'prof') {
        if (!state.eligible) return `<h2>Confirm eligibility first</h2><div class="stp-pane-body"><p>${md(CONFIG.contactText)}</p></div>`;
        const grid = PROFS.map((pr) => `<button class="proto-btn ghost" data-b="pick" data-slug="${pr.slug}" style="text-align:left">${esc(pr.name)} <span class="proto-badge" data-reg="${pr.regulator}">${pr.regulator}</span></button>`).join('');
        return `<h2>Pick your profession</h2><div class="stp-pane-body"><p>We'll walk you through how it works, then unlock your fee options.</p></div><div class="stp-grid" style="margin-top:var(--space-3)">${grid}</div>`;
      }
      if (it.proc != null) {
        const s = processFlow(p).steps[it.proc];
        return `<h2>${esc(s.title)} <span class="proto-badge" data-reg="${p.regulator}">${p.regulator}</span></h2><div class="stp-pane-body">${s.bodyHtml}</div><div class="stp-pane-nav"><button class="proto-btn ghost" data-b="prev">← Back</button><button class="proto-btn" data-b="next">Continue →</button></div>`;
      }
      if (it.key === 'gate') {
        const f = processFlow(p);
        const yes = `<button class="proto-btn" data-b="gate-yes">${esc(f.gateYes)}</button>`;
        const no = f.gateNo ? `<button class="proto-btn ghost" data-b="gate-no">${esc(f.gateNo)}</button>` : '';
        const note = state.gateNo && f.gateNoBody ? `<p class="stp-pane-body" style="margin-top:var(--space-2)"><em>${esc(f.gateNoBody)}</em></p>` : '';
        return `<h2>${esc(f.gateTitle)}</h2><div class="stp-pane-body"><p>${esc(f.gateBody)}</p></div><div class="stp-grid" style="margin-top:var(--space-3)">${yes}${no}</div>${note}`;
      }
      if (it.task) {
        const t = feeTasks(p).find((x) => x.key === it.task);
        return `<h2>${esc(t.label)}${state.done[it.task] ? ' ✓' : ''}</h2><div class="stp-pane-body">${t.bodyHtml}${checklistHtml(p)}</div><div class="stp-pane-nav"><button class="proto-btn ghost" data-b="prev">← Back</button><button class="proto-btn" data-b="task-done">${state.done[it.task] ? 'Done ✓' : 'Mark done'}</button></div>`;
      }
      return `<h2>You're all set</h2><div class="stp-pane-body"><p>${md(CONFIG.contactText)}</p></div>`;
    }

    function render() {
      const list = items();
      if (state.active >= list.length) state.active = list.length - 1;
      const rail = list.map((it, i) => {
        const active = i === state.active;
        const done = isDone(it) && !active;
        const lock = !clickable(it);
        const cls = active ? 'is-active' : done ? 'is-done' : lock ? 'is-locked' : '';
        const dot = done ? '✓' : it.proc != null ? '•' : it.task ? '•' : i + 1;
        return `<li class="stp-step ${cls}" data-b="jump" data-key="${it.key}"><span class="stp-dot">${dot}</span><span>${esc(it.label)}</span></li>`;
      }).join('');
      root.innerHTML = `
        <h1 style="font-size:1.6rem">Licensure & exam fees</h1>
        <div class="stp">
          <nav class="stp-rail" aria-label="Your progress"><h2>Your path</h2><ul class="stp-steps">${rail}</ul></nav>
          <section class="stp-pane">${pane(list[state.active])}</section>
        </div>`;
    }

    root.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-b]');
      if (!btn) return;
      const cur = items()[state.active];
      switch (btn.dataset.b) {
        case 'elig-yes': state.eligible = true; state.active = keyIndex('prof'); break;
        case 'elig-no': state.eligible = false; break;
        case 'pick': state.slug = btn.dataset.slug; state.passedGate = false; state.gateNo = false; state.done = {}; state.active = keyIndex('proc0'); break;
        case 'next': state.active = Math.min(state.active + 1, items().length - 1); break;
        case 'prev': state.active = Math.max(0, state.active - 1); break;
        case 'gate-yes': { state.passedGate = true; state.gateNo = false; const fi = items().findIndex((x) => x.task); if (fi >= 0) state.active = fi; break; }
        case 'gate-no': state.gateNo = true; break;
        case 'task-done': if (cur && cur.task) state.done[cur.task] = true; break;
        case 'jump': { const i = keyIndex(btn.dataset.key); const it = items()[i]; if (i >= 0 && clickable(it)) state.active = i; break; }
      }
      render();
    });

    render();
  }

  // ===== Variant C — conversational =======================================
  function mountC(root) {
    root.innerHTML = `
      <h1 style="font-size:1.5rem;text-align:center">Licensure & exam fees</h1>
      <div class="chat">
        <div class="chat-log" id="chat-log"></div>
        <div class="chat-chips" id="chat-chips"></div>
      </div>`;
    const log = root.querySelector('#chat-log');
    const chips = root.querySelector('#chat-chips');
    const state = { slug: null, done: {} };

    function scroll() { window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' }); }
    function bot(html) {
      const d = document.createElement('div');
      d.className = 'chat-msg bot';
      d.innerHTML = html;
      log.appendChild(d);
      scroll();
    }
    function user(text) {
      const d = document.createElement('div');
      d.className = 'chat-msg user';
      d.textContent = text;
      log.appendChild(d);
      scroll();
    }
    function setChips(opts) {
      chips.innerHTML = '';
      opts.forEach((o) => {
        const b = document.createElement('button');
        b.className = 'chat-chip';
        b.textContent = o.label;
        b.addEventListener('click', () => { user(o.label); chips.innerHTML = ''; o.onClick(); });
        chips.appendChild(b);
      });
      scroll();
    }

    function askProfession() {
      bot('Great. Which credential are you pursuing?');
      setChips(PROFS.map((p) => ({ label: p.name, onClick: () => { state.slug = p.slug; walkProcess(); } })));
    }

    function walkProcess() {
      const p = profBySlug(state.slug);
      const f = processFlow(p);
      bot(`Here's how it works for <strong>${esc(p.name)}</strong> <span class="proto-badge" data-reg="${p.regulator}">${p.regulator}</span>:`);
      f.steps.forEach((s, i) => bot(`<strong>${i + 1}. ${esc(s.title)}</strong><br>${s.bodyHtml}`));
      bot(`<strong>${esc(f.gateTitle)}</strong><br>${esc(f.gateBody)}`);
      const opts = [{ label: f.gateYes, onClick: openHub }];
      if (f.gateNo) {
        opts.push({
          label: f.gateNo,
          onClick: () => {
            bot(f.gateNoBody);
            setChips([{ label: "OK, it's notarized now", onClick: openHub }, { label: 'Start over', onClick: start }]);
          },
        });
      }
      setChips(opts);
    }

    function openHub() {
      const p = profBySlug(state.slug);
      const remaining = feeTasks(p).filter((t) => !state.done[t.key]);
      if (!remaining.length) {
        bot("You're all set. " + md(CONFIG.contactText));
        setChips([{ label: 'Start over', onClick: start }]);
        return;
      }
      bot('What do you need to pay for?');
      const opts = remaining.map((t) => ({
        label: t.label,
        onClick: () => {
          bot(`<strong>${esc(t.label)}</strong><br>${t.bodyHtml}${checklistHtml(p)}`);
          state.done[t.key] = true;
          setChips([{ label: 'Done — what else?', onClick: openHub }]);
        },
      }));
      opts.push({ label: "That's everything", onClick: () => { bot("Great, you're all set. " + md(CONFIG.contactText)); setChips([{ label: 'Start over', onClick: start }]); } });
      setChips(opts);
    }

    function start() {
      log.innerHTML = '';
      state.slug = null;
      state.done = {};
      bot("Hi! I'll point you to the right licensure or exam fee steps. First — " + md(CONFIG.eligibilityText));
      bot('Are you an active 1199SEIU TEF CPT participant?');
      setChips([
        { label: "Yes, I'm active", onClick: askProfession },
        { label: 'No / not sure', onClick: () => { bot(md(CONFIG.contactText)); setChips([{ label: 'Start over', onClick: start }]); } },
      ]);
    }

    start();
  }

  // ===== Wiring ===========================================================
  const MOUNTERS = { A: mountA, B: mountB, C: mountC };
  const containers = { A: document.getElementById('variant-A'), B: document.getElementById('variant-B'), C: document.getElementById('variant-C') };

  function mount(key) {
    const root = containers[key];
    if (!root) return;
    if (root._cleanup) { root._cleanup(); root._cleanup = null; }
    root.innerHTML = '';
    MOUNTERS[key](root);
  }

  window.protoSetVariant = function (key) {
    if (!containers[key]) key = 'A';
    const url = new URL(location.href);
    url.searchParams.set('variant', key);
    history.replaceState({}, '', url);
    Object.keys(containers).forEach((k) => { containers[k].hidden = k !== key; });
    mount(key);
  };

  const initial = new URLSearchParams(location.search).get('variant');
  window.protoSetVariant(MOUNTERS[initial] ? initial : 'A');
</script>
